{
    "name": "nuxt-app",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev --logLevel=verbose",
        "generate": "nuxt generate",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "test:browser": "npm run test:component && npm run test:integration",
        "test:component": "playwright test -c playwright-ct.config.ts",
        "test:e2e": "playwright test --workers=1 --project=e2e-public --project=e2e-user --project=e2e-admin",
        "test:e2e:ui": "playwright test --workers=1 --project=e2e-public --project=e2e-user --project=e2e-admin --ui",
        "test:integration": "playwright test --project=integration"
    },
    "dependencies": {
        "@primeuix/themes": "^1.1.2",
        "@primevue/forms": "^4.3.5",
        "@tailwindcss/vite": "^4.1.10",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "nuxt": "^3.20.1",
        "primevue": "^4.5.1",
        "tailwindcss": "^4.1.10",
        "vue": "^3.5.16",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.12.1",
        "@playwright/experimental-ct-vue": "^1.58.2",
        "@playwright/test": "^1.58.2",
        "@primevue/nuxt-module": "^4.5.1",
        "eslint": "^9.39.0",
        "prettier": "^3.3.3",
        "unplugin-auto-import": "^21.0.0"
    }
}
